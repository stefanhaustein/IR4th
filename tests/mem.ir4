\ mem.ir4 - Named buffer and memory load/store tests (c@, c!, @, !, a@, a!)
\ Expected main() return value: 0

16 buffer: buf_a
32 buffer: buf_b

: assert_eq { W: got W: expected W: code -- W: }
  got expected = if
    0 exit
  then
  code
;

: main { | A: p -- W: }
  \ Byte store / fetch / sext
  0x41 buf_a c!
  0xFF buf_a 1 a+ c!
  buf_a c@ 0x41 1 assert_eq
  dup 0 <> if exit then drop
  buf_a 1 a+ c@ 0xFF 2 assert_eq
  dup 0 <> if exit then drop
  buf_a 1 a+ c@ sext -1 3 assert_eq
  dup 0 <> if exit then drop

  \ Native word store / fetch
  12345 buf_b !
  -5432 buf_b 8 a+ !
  buf_b @ 12345 4 assert_eq
  dup 0 <> if exit then drop
  buf_b 8 a+ @ -5432 5 assert_eq
  dup 0 <> if exit then drop

  \ Address store / fetch (a!, a@)
  buf_a 1 a+ buf_b 16 a+ a!
  buf_b 16 a+ a@ to p
  p buf_a 1 a+ a= -1 6 assert_eq
  dup 0 <> if exit then drop
  p c@ sext -1 7 assert_eq
;
