// mem.ir4 - Named buffer and memory load/store tests (i8@, u8@, i8!, i16@, u16@, i16!, @, !, a@, a!)
// Expected main() return value: 0

var buf_a :bytes 16
var buf_b :bytes 32

fn assert_eq ( got :i expected :i code :i -> :i )
  got expected == if
    0 return
  then
  code
end

fn add_to_var ( vp :a delta :i )
  vp @i delta + vp !i
end

// Recursive test for stack-allocated :bytes local buffers
fn sum_local_buf ( n :i -> :i )
  var tmp :bytes 8
  n 0 <= if 0 return then
  n tmp !i
  n 1 - sum_local_buf tmp @i +
end

fn main ( -> :i )
  var p :a
  var x :i
  // Byte store / fetch / sext
  0x41 buf_a !i8
  0xFF buf_a 1 + !i8
  buf_a @u8 0x41 1 assert_eq
  dup 0 != if return then drop
  buf_a 1 + @u8 0xFF 2 assert_eq
  dup 0 != if return then drop
  buf_a 1 + @u8 sext -1 3 assert_eq
  dup 0 != if return then drop

  // Native word store / fetch
  12345 buf_b !i
  -5432 buf_b 8 + !i
  buf_b @i 12345 4 assert_eq
  dup 0 != if return then drop
  buf_b 8 + @i -5432 5 assert_eq
  dup 0 != if return then drop

  // Address store / fetch (a!, a@)
  buf_a 1 + buf_b 16 + !a
  buf_b 16 + @a -> p
  p buf_a 1 + == -1 6 assert_eq
  dup 0 != if return then drop
  p @u8 sext -1 7 assert_eq
  dup 0 != if return then drop

  // Explicit-width 8-bit and 16-bit ops (i8@, u8@, i8!, i16@, u16@, i16!)
  0xFE buf_a 2 + !i8
  buf_a 2 + @u8 0xFE 8 assert_eq
  dup 0 != if return then drop
  buf_a 2 + @i8 -2 9 assert_eq
  dup 0 != if return then drop

  -1234 buf_b 24 + !i16
  buf_b 24 + @i16 -1234 10 assert_eq
  dup 0 != if return then drop
  0x8001 buf_b 26 + !i16
  buf_b 26 + @u16 0x8001 11 assert_eq
  dup 0 != if return then drop

  // Address-of local (&)
  40 -> x
  & x @i 40 12 assert_eq
  dup 0 != if return then drop
  & x 2 add_to_var
  x 42 13 assert_eq
  dup 0 != if return then drop

  // Stack-allocated :bytes local (recursive)
  5 sum_local_buf 15 14 assert_eq
  dup 0 != if return then drop

  // Fused swap + store (swap !i8, swap !i16, swap !i, swap !a, swap !f)
  buf_a 3 + 0x7B swap !i8
  buf_a 3 + @u8 0x7B 15 assert_eq
  dup 0 != if return then drop

  buf_b 28 + -4321 swap !i16
  buf_b 28 + @i16 -4321 16 assert_eq
  dup 0 != if return then drop

  & x 99 swap !i
  x 99 17 assert_eq
  dup 0 != if return then drop

  buf_b 16 + buf_a 3 + swap !a
  buf_b 16 + @a buf_a 3 + == -1 18 assert_eq
  dup 0 != if return then drop

  buf_b 24 + 2.5 swap !f
  buf_b 24 + @f 2.5 == -1 19 assert_eq
end
