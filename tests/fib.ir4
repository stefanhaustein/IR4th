\ fib.ir4 - Recursive and iterative Fibonacci in IR4th

fn fib_rec ( n :i -> :i )
  n 2 < if
    n return
  then
  n 1 - fib_rec
  n 2 - fib_rec
  +
end

fn fib_iter ( n :i -> :i )
  var a :i
  var b :i
  var tmp :i
  var i :i
  0 -> a
  1 -> b
  0 -> i
  begin
    i n <
  while
    a b + -> tmp
    b -> a
    tmp -> b
    i 1 + -> i
  repeat
  a
end

\ Entry point called by --run (computes fib_rec(10) + fib_iter(10) = 55 + 55 = 110)
fn main ( -> :i )
  10 fib_rec
  10 fib_iter
  +
end
