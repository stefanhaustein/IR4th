\ stdio.ir4 - Portable console/terminal I/O, formatting, and screen control
\ Platform overrides implement raw `emit` (and optionally the `default fn` entries below).

\ Emit character c with platform text mapping (defaults to raw emit; PETSCII on C64)
default fn xemit ( c :i )
  c emit
end

\ Emit a newline
fn cr ( )
  10 xemit
end

\ Print len bytes starting at s
fn type ( s :a len :i )
  begin
    len 0 >
  while
    s u8@ xemit
    s 1 a+ -> s
    len 1 - -> len
  repeat
end

\ Print NUL-terminated string at s
fn type0 ( s :a )
  begin
    s u8@ -> var c :i
    c 0 <>
  while
    c xemit
    s 1 a+ -> s
  repeat
end

\ Print n as minimal unsigned decimal
fn typeu ( n :i )
  var buf :bytes 20
  0 -> var len :i
  n 0 = if 48 xemit return then
  begin
    n 0 <>
  while
    n 10 umod 48 + buf len a+ i8!
    n 10 u/ -> n
    len 1 + -> len
  repeat
  begin
    len 0 >
  while
    len 1 - -> len
    buf len a+ u8@ xemit
  repeat
end

\ Print n as signed decimal
fn typei ( n :i )
  n 0 < if
    45 xemit
    0 n - typeu
    return
  then
  n typeu
end

\ Print n as signed decimal, right-aligned with spaces to width w
fn typei_w ( n :i w :i )
  0 -> var d :i
  n -> var t :i
  t 0 < if
    1 -> d
    0 t - -> t
  then
  t 0 = if
    d 1 + -> d
  else
    begin
      t 0 <>
    while
      d 1 + -> d
      t 10 u/ -> t
    repeat
  then
  begin
    w d >
  while
    32 xemit
    w 1 - -> w
  repeat
  n typei
end

\ Print n as w zero-padded uppercase hex digits
fn typeh_w ( n :i w :i )
  begin
    w 0 >
  while
    w 1 - -> w
    n w 2 << u>> 15 and -> var d :i
    d 10 < if
      d 48 + xemit
    else
      d 55 + xemit
    then
  repeat
end

\ Print n as minimal uppercase hex
fn typeh ( n :i )
  n -> var t :i
  1 -> var w :i
  begin
    t 15 u>
  while
    t 4 u>> -> t
    w 1 + -> w
  repeat
  n w typeh_w
end

\ Clear screen and home cursor (ANSI default)
default fn cls ( )
  27 emit 91 emit 50 emit 74 emit
  27 emit 91 emit 72 emit
end

\ Move text cursor to 0-based column x, row y (ANSI default)
default fn gotoxy ( x :i y :i )
  27 emit 91 emit
  y 1 + typeu
  59 emit
  x 1 + typeu
  72 emit
end

\ Return terminal width in columns
default fn termwidth ( -> :i )
  80
end

\ Return terminal height in rows
default fn termheight ( -> :i )
  24
end

\ Set foreground text color using ANSI color index (0..7, 8..15 bright)
default fn fgcolor ( c :i )
  27 emit 91 emit
  c 8 < if 30 c + else 82 c + then typeu
  109 emit
end

\ Set background text color using ANSI color index (0..7, 8..15 bright)
default fn bgcolor ( c :i )
  27 emit 91 emit
  c 8 < if 40 c + else 92 c + then typeu
  109 emit
end
