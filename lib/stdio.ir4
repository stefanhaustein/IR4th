require "io.ir4"

fn cr ( )
  10 emit
end

fn type ( s :a len :i )
  begin
    len 0 >
  while
    s u8@ emit
    s 1 a+ -> s
    len 1 - -> len
  repeat
end

fn prints ( s :a )
  var c :i
  begin
    s u8@ -> c
    c 0 <>
  while
    c emit
    s 1 a+ -> s
  repeat
end

fn putu ( n :i )
  n 9 u> if n 10 u/ putu then
  n 10 umod 48 + emit
end

fn puti ( n :i )
  n 0 < if
    45 emit
    0 n - putu
    return
  then
  n putu
end

fn puti_w ( n :i w :i )
  var d :i
  var t :i
  n -> t
  t 0 < if
    1 -> d
    0 t - -> t
  else
    0 -> d
  then
  t 0 = if
    d 1 + -> d
  else
    begin
      t 0 <>
    while
      d 1 + -> d
      t 10 u/ -> t
    repeat
  then
  begin
    w d >
  while
    32 emit
    w 1 - -> w
  repeat
  n puti
end

fn puthex1 ( d :i )
  d 15 and -> d
  d 10 < if
    d 48 + emit
  else
    d 55 + emit
  then
end

fn puthex2 ( n :i )
  n 4 u>> puthex1
  n puthex1
end

fn puthex4 ( n :i )
  n 8 u>> puthex2
  n puthex2
end
