\ Pure-IR4th IEEE-754 single-precision (32-bit) soft-float library
\ Used by backends with soft_float = true (e.g. ez80).

var _f32_tmp :bytes 4

default fn f>bits ( x :f -> :i32 )
  x _f32_tmp f!
  _f32_tmp i32@
end

default fn bits>f ( u :i32 -> :f )
  u _f32_tmp i32!
  _f32_tmp f@
end

default fn fnegate ( x :f -> :f )
  x f>bits 1 i>u32 31 i32<< i32xor bits>f
end

default fn f= ( x :f y :f -> :i )
  var a :i32
  var b :i32
  var mask :i32
  1 i>u32 31 i32<< 1 i>u32 i32- -> mask
  x f>bits -> a
  y f>bits -> b
  a mask i32and 0 i>i32 i32= if
    b mask i32and 0 i>i32 i32= if
      -1 return
    then
  then
  a b i32=
end

default fn f<> ( x :f y :f -> :i )
  x y f= 0 =
end

default fn f< ( x :f y :f -> :i )
  var a :i32
  var b :i32
  var mask :i32
  var sa :i
  var sb :i
  1 i>u32 31 i32<< 1 i>u32 i32- -> mask
  x f>bits -> a
  y f>bits -> b
  a mask i32and 0 i>i32 i32= if
    b mask i32and 0 i>i32 i32= if
      0 return
    then
  then
  a 31 u32>> i32>i -> sa
  b 31 u32>> i32>i -> sb
  sa sb <> if
    sa 0 <> return
  then
  sa 0 = if
    a b u32<
  else
    b a u32<
  then
end

default fn f> ( x :f y :f -> :i )
  y x f<
end

default fn i>f ( n :i -> :f )
  var s :i
  var e :i
  var u :i32
  n 0 = if
    0 i>i32 bits>f return
  then
  0 -> s
  n 0 < if
    1 -> s
    0 n - -> n
  then
  n i>u32 -> u
  150 -> e
  begin u 1 i>u32 23 i32<< u32< while
    u 1 i32<< -> u
    e 1 - -> e
  repeat
  s i>u32 31 i32<<
  e i>u32 23 i32<< i32or
  u 1 i>u32 23 i32<< 1 i>u32 i32- i32and i32or
  bits>f
end

default fn f>i ( x :f -> :i )
  var u :i32
  var m :i32
  var s :i
  var e :i
  var r :i
  x f>bits -> u
  u 31 u32>> i32>i -> s
  u 23 u32>> i32>i 255 and 127 - -> e
  e 0 < if
    0 return
  then
  u 1 i>u32 23 i32<< 1 i>u32 i32- i32and 1 i>u32 23 i32<< i32or -> m
  e 23 >= if
    m e 23 - i32<< i32>i -> r
  else
    m 23 e - u32>> i32>i -> r
  then
  s 0 <> if
    0 r - -> r
  then
  r
end

default fn f+ ( x :f y :f -> :f )
  var a :i32
  var b :i32
  var t :i32
  var ma :i32
  var mb :i32
  var mr :i32
  var ea :i
  var eb :i
  var et :i
  var sa :i
  var sb :i
  var diff :i
  x f>bits -> a
  y f>bits -> b
  a 23 u32>> i32>i 255 and -> ea
  b 23 u32>> i32>i 255 and -> eb
  ea 0 = if y return then
  eb 0 = if x return then
  ea eb < if
    a -> t b -> a t -> b
    ea -> et eb -> ea et -> eb
  else
    ea eb = if
      a 1 i>u32 23 i32<< 1 i>u32 i32- i32and b 1 i>u32 23 i32<< 1 i>u32 i32- i32and u32< if
        a -> t b -> a t -> b
      then
    then
  then
  a 31 u32>> i32>i -> sa
  b 31 u32>> i32>i -> sb
  a 1 i>u32 23 i32<< 1 i>u32 i32- i32and 1 i>u32 23 i32<< i32or 3 i32<< -> ma
  b 1 i>u32 23 i32<< 1 i>u32 i32- i32and 1 i>u32 23 i32<< i32or 3 i32<< -> mb
  ea eb - -> diff
  diff 26 > if x return then
  mb diff u32>> -> mb
  sa sb = if
    ma mb i32+ -> mr
  else
    ma mb i32- -> mr
  then
  mr 0 i>i32 i32= if
    0 i>i32 bits>f return
  then
  mr 1 i>u32 27 i32<< u32>= if
    mr 1 u32>> -> mr
    ea 1 + -> ea
  else
    begin mr 1 i>u32 26 i32<< u32< while
      mr 1 i32<< -> mr
      ea 1 - -> ea
    repeat
  then
  mr 4 i>u32 i32+ -> mr
  mr 1 i>u32 27 i32<< u32>= if
    mr 1 u32>> -> mr
    ea 1 + -> ea
  then
  mr 3 u32>> -> mr
  ea 0 <= if
    0 i>i32 bits>f return
  then
  sa i>u32 31 i32<<
  ea i>u32 23 i32<< i32or
  mr 1 i>u32 23 i32<< 1 i>u32 i32- i32and i32or
  bits>f
end

default fn f- ( x :f y :f -> :f )
  x y fnegate f+
end

default fn f* ( x :f y :f -> :f )
  var a :i32
  var b :i32
  var ma :i32
  var mb :i32
  var ah :i32
  var al :i32
  var bh :i32
  var bl :i32
  var mid :i32
  var p :i32
  var ea :i
  var eb :i
  var er :i
  var sr :i
  x f>bits -> a
  y f>bits -> b
  a 23 u32>> i32>i 255 and -> ea
  b 23 u32>> i32>i 255 and -> eb
  ea 0 = if 0 i>i32 bits>f return then
  eb 0 = if 0 i>i32 bits>f return then
  a 31 u32>> i32>i b 31 u32>> i32>i xor -> sr
  ea eb + 127 - -> er
  a 1 i>u32 23 i32<< 1 i>u32 i32- i32and 1 i>u32 23 i32<< i32or -> ma
  b 1 i>u32 23 i32<< 1 i>u32 i32- i32and 1 i>u32 23 i32<< i32or -> mb
  ma 12 u32>> -> ah
  ma 0xFFF i>u32 i32and -> al
  mb 12 u32>> -> bh
  mb 0xFFF i>u32 i32and -> bl
  ah bl i32* al bh i32* i32+ -> mid
  al bl i32* 12 u32>> mid i32+ -> mid
  ah bh i32* mid 12 u32>> i32+ -> p
  p 1 i>u32 23 i32<< u32>= if
    er 1 + -> er
  else
    p 1 i32<< -> p
    mid 0x800 i>u32 i32and 0 i>i32 i32<> if
      p 1 i>u32 i32+ -> p
      p 1 i>u32 24 i32<< u32>= if
        p 1 u32>> -> p
        er 1 + -> er
      then
    then
  then
  er 0 <= if 0 i>i32 bits>f return then
  sr i>u32 31 i32<<
  er i>u32 23 i32<< i32or
  p 1 i>u32 23 i32<< 1 i>u32 i32- i32and i32or
  bits>f
end

default fn f/ ( x :f y :f -> :f )
  var a :i32
  var b :i32
  var ma :i32
  var mb :i32
  var q :i32
  var ea :i
  var eb :i
  var er :i
  var sr :i
  var i :i
  x f>bits -> a
  y f>bits -> b
  a 23 u32>> i32>i 255 and -> ea
  b 23 u32>> i32>i 255 and -> eb
  ea 0 = if 0 i>i32 bits>f return then
  eb 0 = if 0 i>i32 bits>f return then
  a 31 u32>> i32>i b 31 u32>> i32>i xor -> sr
  ea eb - 127 + -> er
  a 1 i>u32 23 i32<< 1 i>u32 i32- i32and 1 i>u32 23 i32<< i32or -> ma
  b 1 i>u32 23 i32<< 1 i>u32 i32- i32and 1 i>u32 23 i32<< i32or -> mb
  0 i>i32 -> q
  0 -> i
  begin i 25 < while
    q 1 i32<< -> q
    ma mb u32>= if
      ma mb i32- -> ma
      q 1 i>u32 i32or -> q
    then
    ma 1 i32<< -> ma
    i 1 + -> i
  repeat
  q 1 i>u32 24 i32<< u32>= if
    q 1 i>u32 i32+ 1 u32>> -> q
  else
    er 1 - -> er
  then
  er 0 <= if 0 i>i32 bits>f return then
  sr i>u32 31 i32<<
  er i>u32 23 i32<< i32or
  q 1 i>u32 23 i32<< 1 i>u32 i32- i32and i32or
  bits>f
end
