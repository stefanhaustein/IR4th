\ lib/zx81/gfx.ir4 - Sinclair ZX81 64x48 block-mosaic pixel graphics in D_FILE

require "stdio.ir4"

var __zx81_col :i

data __zx81_modes
  "64x48 (2x2 mosaic)" 0 :i8
end

fn gfxmodes ( -> :a :i )
  __zx81_modes 1
end

fn gfxwidth ( -> :i ) 64 end
fn gfxheight ( -> :i ) 48 end
fn gfxdepth ( -> :i ) 1 end

fn gfxmode ( mode :i )
  1 -> __zx81_col
  cls
end

fn gfxdone ( )
end

fn gfxvsync ( )
end

fn gfxrgb ( r :i g :i b :i -> :i )
  r g + b + 382 >= if 1 else 0 then
end

fn gfxcolor ( c :i )
  c 0 <> if 1 else 0 then -> __zx81_col
end

fn gfxclear ( )
  var df :a
  var r :i
  var c :i
  0x400C i>a a@ -> df
  0 -> r
  begin r 24 < while
    0 -> c
    begin c 32 < while
      0 df 1 r 33 * + c + a+ i8!
      c 1 + -> c
    repeat
    r 1 + -> r
  repeat
end

fn gfxpx ( x :i y :i )
  var df :a
  var p :a
  var ch :i
  var bits :i
  var mask :i
  x 0 < x 64 >= or y 0 < y 48 >= or or if return then
  0x400C i>a a@ -> df
  df 1 y 1 u>> 33 * + x 1 u>> + a+ -> p
  p u8@ -> ch
  ch 8 < if
    ch -> bits
  else
    ch 0x80 >= ch 0x87 <= and if
      0x8F ch - -> bits
    else
      0 -> bits
    then
  then
  1 x 1 and + y 1 and 0 <> if 2 << then -> mask
  __zx81_col 0 <> if
    bits mask or -> bits
  else
    bits mask 15 xor and -> bits
  then
  bits 8 < if
    bits p i8!
  else
    0x8F bits - p i8!
  then
end
