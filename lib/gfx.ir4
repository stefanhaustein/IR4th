\ gfx.ir4 - Portable stateful pixel graphics (default: ANSI 8-color UTF-8 half-block backend)
\ Platform overrides (e.g. agon/gfx.ir4, c64/gfx.ir4) implement gfxmodes, gfxmode, gfxdone,
\ gfxwidth, gfxheight, gfxdepth, gfxvsync, gfxrgb, gfxcolor, gfxpx (and optionally gfxclear, gfxline, gfxhline, gfxvline, gfxfillrect).

require "stdio.ir4"
require "mem.ir4"

var __gfx_def_modes :bytes 8
var __gfx_w :i
var __gfx_h :i
var __gfx_col :i
var __gfx_fb :a

\ Returns (addr, count) of :i16 4-tuples: (mode, width, height, depth_bpp)
default fn gfxmodes ( -> :a :i )
  0 __gfx_def_modes i16!
  termwidth __gfx_def_modes 2 a+ i16!
  termheight 1 << __gfx_def_modes 4 a+ i16!
  3 __gfx_def_modes 6 a+ i16!
  __gfx_def_modes 1
end

default fn gfxwidth ( -> :i ) __gfx_w end
default fn gfxheight ( -> :i ) __gfx_h end
default fn gfxdepth ( -> :i ) 3 end
default fn gfxvsync ( ) end

default fn gfxmode ( mode :i )
  mode drop
  termwidth -> __gfx_w
  termheight 1 << -> __gfx_h
  __gfx_fb 0 i>a a<> if __gfx_fb heap_free then
  __gfx_w termheight * heap_alloc -> __gfx_fb
  __gfx_fb __gfx_w termheight * 0 fillchar
  7 -> __gfx_col
  cls
end

default fn gfxdone ( )
  __gfx_fb 0 i>a a<> if
    __gfx_fb heap_free
    0 i>a -> __gfx_fb
  then
  27 emit 91 emit 48 emit 109 emit
  0 termheight 1 - gotoxy
  cr
end

\ Enter best-matching mode from gfxmodes for (w, h, depth_bpp); (0, 0, 0) selects entry 0
default fn gfxinit ( w :i h :i depth :i )
  var tbl :a
  var cnt :i
  var p :a
  var best_mode :i
  var best_score :i
  var mw :i
  var mh :i
  var md :i
  var dw :i
  var dh :i
  var dd :i
  var score :i
  gfxmodes -> cnt -> tbl
  cnt 0 <= if 0 gfxmode return then
  tbl i16@ -> best_mode
  w 0 = h 0 = and depth 0 = and if best_mode gfxmode return then
  32767 -> best_score
  tbl -> p
  begin cnt 0 > while
    p 2 a+ i16@ -> mw
    p 4 a+ i16@ -> mh
    p 6 a+ i16@ -> md
    mw w - -> dw  dw 0 < if 0 dw - -> dw then
    mh h - -> dh  dh 0 < if 0 dh - -> dh then
    md depth - -> dd  dd 0 < if 0 dd - -> dd then
    dw dh + dd 5 << + -> score
    score best_score < if
      score -> best_score
      p i16@ -> best_mode
    then
    p 8 a+ -> p
    cnt 1 - -> cnt
  repeat
  best_mode gfxmode
end

\ Map 8-bit RGB (0..255) to the platform's native color value for gfxcolor
default fn gfxrgb ( r :i g :i b :i -> :i )
  var c :i
  0 -> c
  r 128 >= if c 1 or -> c then
  g 128 >= if c 2 or -> c then
  b 128 >= if c 4 or -> c then
  c
end

default fn gfxcolor ( c :i )
  c 7 and -> __gfx_col
end

fn __gfx_emit_cell ( cx :i cy :i val :i )
  cx cy gotoxy
  val 4 u>> fgcolor
  val 15 and bgcolor
  226 emit 150 emit 128 emit
end

default fn gfxpx ( x :i y :i )
  var cell :a
  var old :i
  var val :i
  x 0 < x __gfx_w >= or y 0 < y __gfx_h >= or or if return then
  __gfx_fb y 1 u>> __gfx_w * x + a+ -> cell
  cell u8@ -> old
  y 1 and 0 = if
    old 15 and __gfx_col 4 << or -> val
  else
    old 240 and __gfx_col or -> val
  then
  val cell i8!
  x y 1 u>> val __gfx_emit_cell
end

default fn gfxhline ( x :i y :i w :i )
  begin w 0 > while
    x y gfxpx
    x 1 + -> x
    w 1 - -> w
  repeat
end

default fn gfxvline ( x :i y :i h :i )
  begin h 0 > while
    x y gfxpx
    y 1 + -> y
    h 1 - -> h
  repeat
end

default fn gfxline ( x1 :i y1 :i x2 :i y2 :i )
  var dx :i
  var dy :i
  var sx :i
  var sy :i
  var err :i
  var e2 :i
  x2 x1 - -> dx
  dx 0 < if 0 dx - -> dx -1 -> sx else 1 -> sx then
  y2 y1 - -> dy
  dy 0 < if 0 dy - -> dy -1 -> sy else 1 -> sy then
  0 dy - -> dy
  dx dy + -> err
  begin -1 while
    x1 y1 gfxpx
    x1 x2 = y1 y2 = and if return then
    err 1 << -> e2
    e2 dy >= if err dy + -> err x1 sx + -> x1 then
    e2 dx <= if err dx + -> err y1 sy + -> y1 then
  repeat
end

default fn gfxrect ( x :i y :i w :i h :i )
  w 0 <= h 0 <= or if return then
  x y w gfxhline
  x y h + 1 - w gfxhline
  x y h gfxvline
  x w + 1 - y h gfxvline
end

default fn gfxfillrect ( x :i y :i w :i h :i )
  var ye :i
  w 0 <= h 0 <= or if return then
  y h + -> ye
  begin y ye < while
    x y w gfxhline
    y 1 + -> y
  repeat
end

default fn gfxclear ( )
  __gfx_fb __gfx_w termheight * __gfx_col 4 << __gfx_col or fillchar
  __gfx_col bgcolor
  cls
end
