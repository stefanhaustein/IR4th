extern emit 0xFFD2 ( A :i )
extern inkey 0xFFE4 ( -> A :i )

fn key ( -> :i )
  0 -> var c :i
  begin
    inkey -> c
    c 0 =
  while repeat
  c
end

fn xemit ( c :i )
  c 10 = if 13 emit return then
  c 97 >= c 122 <= and if c 32 - emit return then
  c emit
end

fn cls ( )
  147 emit
end

fn gotoxy ( x :i y :i )
  19 emit
  begin y 0 > while 17 emit y 1 - -> y repeat
  begin x 0 > while 29 emit x 1 - -> x repeat
end

fn termwidth ( -> :i )
  40
end

fn termheight ( -> :i )
  25
end

data __c64_pal
  0 :i8 2 :i8 5 :i8 7 :i8 6 :i8 4 :i8 3 :i8 1 :i8
end

fn fgcolor ( c :i )
  __c64_pal c 7 and a+ u8@ 646 i>a i8!
end

fn bgcolor ( c :i )
  __c64_pal c 7 and a+ u8@ 53281 i>a i8!
end
