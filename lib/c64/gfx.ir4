\ c64/gfx.ir4 - Commodore 64 VIC-II Hires Bitmap (320x200) in VIC Bank 3 ($C000-$FFFF)
\
\ Memory layout:
\   $0801-$CBFF (~49 KB) : Unbroken Code + BSS + Heap + bfp frame stack (ram_top = $CC00)
\   $CC00-$CFE7 (1000 B) : VIC Character RAM (foreground/background 8x8 color attributes)
\   $D000-$DFFF          : VIC / SID / CIA I/O
\   $E000-$FF3F (8000 B) : VIC Graphics RAM (underneath KERNAL ROM; CPU writes go to RAM,
\                          reads use __c64_peek_under with $01=$35 while IRQs are disabled)
\
\ Color model:
\   gfxdepth returns 1 (1 bpp pixel density, so B/W-aware apps like mandel avoid clash),
\   while gfxrgb maps RGB to 8 C64 colors and gfxpx/gfxhline/gfxvline update the 8x8 cell
\   foreground attribute in $CC00 (ZX Spectrum-style attribute clash; bg stays color 0).

data __c64_modes
  0 :i16 320 :i16 200 :i16 1 :i16
end

data __c64_gfx_pal
  0 :i8 2 :i8 5 :i8 7 :i8 6 :i8 4 :i8 3 :i8 1 :i8
end

var __c64_col :i

\ Read 1 byte from RAM underneath KERNAL ROM ($E000-$FFFF) with IRQs disabled
code __c64_peek_under ( p :a -> :i )
  0xBD :i8 0 :as 0x85 :i8 0x02 :i8
  0xBD :i8 1 :as 0x85 :i8 0x03 :i8
  0x78 :i8 0xA9 :i8 0x35 :i8 0x85 :i8 0x01 :i8
  0xA0 :i8 0x00 :i8 0xB1 :i8 0x02 :i8 0xA8 :i8
  0xA9 :i8 0x36 :i8 0x85 :i8 0x01 :i8 0x58 :i8
  0x98 :i8 0x9D :i8 0 :as
  0xA9 :i8 0x00 :i8 0x9D :i8 1 :as
  0x60 :i8
end

fn gfxmodes ( -> :a :i )
  __c64_modes 1
end

fn gfxwidth ( -> :i ) 320 end
fn gfxheight ( -> :i ) 200 end
fn gfxdepth ( -> :i ) 1 end

fn gfxmode ( mode :i )
  mode drop
  1 -> __c64_col
  \ Select VIC bank 3 ($C000-$FFFF): CIA2 $DD00 bits 0..1 = 0
  56576 i>a u8@ 252 and 56576 i>a i8!
  \ Character RAM at $CC00 ($0C00 in bank), Graphics RAM at $E000 ($2000 in bank): $D018 = $38
  56 53272 i>a i8!
  \ Enable bitmap mode: $D011 = $3B
  59 53265 i>a i8!
end

fn gfxdone ( )
  \ Restore VIC bank 0, screen $0400 / char ROM $1000 ($D018 = $15), text mode ($D011 = $1B)
  56576 i>a u8@ 252 and 3 or 56576 i>a i8!
  21 53272 i>a i8!
  27 53265 i>a i8!
end

fn gfxvsync ( )
  begin 53266 i>a u8@ 255 <> while repeat
end

fn gfxrgb ( r :i g :i b :i -> :i )
  0 -> var idx :i
  r 128 >= if idx 1 or -> idx then
  g 128 >= if idx 2 or -> idx then
  b 128 >= if idx 4 or -> idx then
  __c64_gfx_pal idx a+ u8@
end

fn gfxcolor ( c :i )
  c 15 and -> __c64_col
end

fn gfxclear ( )
  0xE000 i>a -> var p :a
  8000 -> var n :i
  begin n 0 > while
    0 p i8!
    p 1 a+ -> p
    n 1 - -> n
  repeat
  __c64_col 0 = if 0 else __c64_col 4 << then -> var attr :i
  0xCC00 i>a -> p
  1000 -> n
  begin n 0 > while
    attr p i8!
    p 1 a+ -> p
    n 1 - -> n
  repeat
end

hot fn gfxpx ( x :i y :i )
  x 0 < x 320 >= or y 0 < y 200 >= or or if return then
  y 3 u>> -> var row :i
  x 3 u>> -> var col :i
  row 8 << row 6 << + col 3 << + y 7 and + -> var off :i
  0xE000 i>a off a+ -> var p :a
  128 x 7 and u>> -> var mask :i
  __c64_col 0 <> if
    p __c64_peek_under mask or p i8!
    0xCC00 i>a row 5 << row 3 << + col + a+ -> var cell :a
    cell u8@ 15 and __c64_col 4 << or cell i8!
  else
    p __c64_peek_under mask 255 xor and p i8!
  then
end

hot fn gfxhline ( x :i y :i w :i )
  y 0 < y 200 >= or if return then
  x 0 < if w x + -> w 0 -> x then
  x w + 320 > if 320 x - -> w then
  w 0 <= if return then
  y 3 u>> -> var row :i
  begin w 0 > while
    x 7 and 0 = w 8 >= and if
      x 3 u>> -> var col :i
      0xE000 i>a row 8 << row 6 << + col 3 << + y 7 and + a+ -> var p :a
      __c64_col 0 <> if
        255 p i8!
        0xCC00 i>a row 5 << row 3 << + col + a+ -> var cell :a
        cell u8@ 15 and __c64_col 4 << or cell i8!
      else
        0 p i8!
      then
      x 8 + -> x
      w 8 - -> w
    else
      x 3 u>> -> col
      0xE000 i>a row 8 << row 6 << + col 3 << + y 7 and + a+ -> p
      128 x 7 and u>> -> var mask :i
      __c64_col 0 <> if
        p __c64_peek_under mask or p i8!
        0xCC00 i>a row 5 << row 3 << + col + a+ -> cell
        cell u8@ 15 and __c64_col 4 << or cell i8!
      else
        p __c64_peek_under mask 255 xor and p i8!
      then
      x 1 + -> x
      w 1 - -> w
    then
  repeat
end

fn gfxvline ( x :i y :i h :i )
  x 0 < x 320 >= or if return then
  y 0 < if h y + -> h 0 -> y then
  y h + 200 > if 200 y - -> h then
  h 0 <= if return then
  y 3 u>> -> var row :i
  x 3 u>> -> var col :i
  y 7 and -> var ry :i
  0xE000 i>a row 8 << row 6 << + col 3 << + ry + a+ -> var p :a
  0xCC00 i>a row 5 << row 3 << + col + a+ -> var cell :a
  128 x 7 and u>> -> var mask :i
  mask 255 xor -> var nmask :i
  x 0 < x 320 >= or if return then
  y 0 < if h y + -> h 0 -> y then
  y h + 200 > if 200 y - -> h then
  h 0 <= if return then
  y 3 u>> -> row
  x 3 u>> -> col
  y 7 and -> ry
  0xE000 i>a row 8 << row 6 << + col 3 << + ry + a+ -> p
  0xCC00 i>a row 5 << row 3 << + col + a+ -> cell
  128 x 7 and u>> -> mask
  mask 255 xor -> nmask
  __c64_col 0 <> if
    cell u8@ 15 and __c64_col 4 << or cell i8!
  then
  begin h 0 > while
    __c64_col 0 <> if
      p __c64_peek_under mask or p i8!
    else
      p __c64_peek_under nmask and p i8!
    then
    h 1 - -> h
    h 0 > if
      ry 7 = if
        0 -> ry
        p 313 a+ -> p
        cell 40 a+ -> cell
        __c64_col 0 <> if
          cell u8@ 15 and __c64_col 4 << or cell i8!
        then
      else
        ry 1 + -> ry
        p 1 a+ -> p
      then
    then
  repeat
end
