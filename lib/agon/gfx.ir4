\ agon/gfx.ir4 - Agon VDP stateful graphics

data __agon_modes
  8  :i16 320 :i16 240 :i16 6 :i16
  9  :i16 320 :i16 240 :i16 4 :i16
  10 :i16 320 :i16 240 :i16 2 :i16
  11 :i16 320 :i16 240 :i16 1 :i16
  1  :i16 512 :i16 384 :i16 4 :i16
  2  :i16 512 :i16 384 :i16 2 :i16
  0  :i16 640 :i16 480 :i16 4 :i16
  4  :i16 640 :i16 480 :i16 1 :i16
  12 :i16 320 :i16 200 :i16 6 :i16
  16 :i16 640 :i16 240 :i16 6 :i16
end

var __gw :i
var __gh :i
var __gd :i

code __vdu ( b :i )
  0xD1 :i8 0xE1 :i8 0xD5 :i8 0x7D :i8 0x5B :i8 0xD7 :i8 0xC9 :i8
end

fn __vdu16 ( v :i )
  v 255 and __vdu
  v 8 >> 255 and __vdu
end

fn __vdu_plot ( m :i x :i y :i )
  25 __vdu m __vdu x __vdu16 y __vdu16
end

fn gfxmodes ( -> :a :i )
  __agon_modes 10
end

fn gfxwidth ( -> :i ) __gw end
fn gfxheight ( -> :i ) __gh end
fn gfxdepth ( -> :i ) __gd end

fn gfxmode ( mode :i )
  var p :a
  var n :i
  320 -> __gw
  240 -> __gh
  6 -> __gd
  __agon_modes -> p
  10 -> n
  begin n 0 > while
    p i16@ mode = if
      p 2 a+ i16@ -> __gw
      p 4 a+ i16@ -> __gh
      p 6 a+ i16@ -> __gd
      0 -> n
    else
      p 8 a+ -> p
      n 1 - -> n
    then
  repeat
  22 __vdu mode __vdu
  23 __vdu 0 __vdu 192 __vdu 0 __vdu
  23 __vdu 1 __vdu 0 __vdu
end

fn gfxdone ( )
  22 __vdu 0 __vdu
  23 __vdu 1 __vdu 1 __vdu
end

fn gfxvsync ( )
  23 __vdu 0 __vdu 195 __vdu
end

fn gfxcolor ( c :i )
  18 __vdu 0 __vdu c __vdu
end

fn gfxpx ( x :i y :i )
  69 x y __vdu_plot
end

fn gfxhline ( x :i y :i w :i )
  w 0 <= if return then
  4 x y __vdu_plot
  5 x w + 1 - y __vdu_plot
end

fn gfxvline ( x :i y :i h :i )
  h 0 <= if return then
  4 x y __vdu_plot
  5 x y h + 1 - __vdu_plot
end

fn gfxline ( x1 :i y1 :i x2 :i y2 :i )
  4 x1 y1 __vdu_plot
  5 x2 y2 __vdu_plot
end

fn gfxfillrect ( x :i y :i w :i h :i )
  w 0 <= h 0 <= or if return then
  4 x y __vdu_plot
  101 x w + 1 - y h + 1 - __vdu_plot
end

fn gfxclear ( )
  0 0 __gw __gh gfxfillrect
end
