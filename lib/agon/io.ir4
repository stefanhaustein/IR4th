\ agon/io.ir4 - Agon MOS console I/O (RST $10 = print char in A)
\ ADL mode: POP DE (ret), POP HL (c), PUSH DE, LD A, L, RST $10, RET

code emit ( c :i )
  0xD1 :i8 0xE1 :i8 0xD5 :i8 0x7D :i8 0x5B :i8 0xD7 :i8 0xC9 :i8
end

code key ( -> :i )
  0xAF :i8 0x5B :i8 0xCF :i8 0xB7 :i8 0x28 :i8 0xFA :i8
  0x21 :i8 0x00 :i8 0x00 :i8 0x00 :i8 0x6F :i8
  0xD1 :i8 0xE5 :i8 0xD5 :i8 0xC9 :i8
end
