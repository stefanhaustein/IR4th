\ eZ80 32-bit helpers (shifts in machine code, mul/udiv/umod in IR4th)

code i32<< ( a :i32 cnt :i -> :i32 )
  0xD1 :i8 0xC1 :i8 0x79 :i8 0xE6 :i8 0x1F :i8 0x28 :i8 0x16 :i8
  0x47 :i8 0x21 :i8 0x00 :i8 0x00 :i8 0x00 :i8 0x39 :i8
  0xCB :i8 0x26 :i8 0x23 :i8 0xCB :i8 0x16 :i8 0x23 :i8
  0xCB :i8 0x16 :i8 0x23 :i8 0xCB :i8 0x16 :i8
  0x2B :i8 0x2B :i8 0x2B :i8 0x10 :i8 0xF0 :i8
  0xD5 :i8 0xC9 :i8
end

code u32>> ( a :i32 cnt :i -> :i32 )
  0xD1 :i8 0xC1 :i8 0x79 :i8 0xE6 :i8 0x1F :i8 0x28 :i8 0x16 :i8
  0x47 :i8 0x21 :i8 0x03 :i8 0x00 :i8 0x00 :i8 0x39 :i8
  0xCB :i8 0x3E :i8 0x2B :i8 0xCB :i8 0x1E :i8 0x2B :i8
  0xCB :i8 0x1E :i8 0x2B :i8 0xCB :i8 0x1E :i8
  0x23 :i8 0x23 :i8 0x23 :i8 0x10 :i8 0xF0 :i8
  0xD5 :i8 0xC9 :i8
end

code i32>> ( a :i32 cnt :i -> :i32 )
  0xD1 :i8 0xC1 :i8 0x79 :i8 0xE6 :i8 0x1F :i8 0x28 :i8 0x16 :i8
  0x47 :i8 0x21 :i8 0x03 :i8 0x00 :i8 0x00 :i8 0x39 :i8
  0xCB :i8 0x2E :i8 0x2B :i8 0xCB :i8 0x1E :i8 0x2B :i8
  0xCB :i8 0x1E :i8 0x2B :i8 0xCB :i8 0x1E :i8
  0x23 :i8 0x23 :i8 0x23 :i8 0x10 :i8 0xF0 :i8
  0xD5 :i8 0xC9 :i8
end

default fn i32* ( a :i32 b :i32 -> :i32 )
  var res :i32
  var i :i
  0 i>i32 -> res
  0 -> i
  begin i 32 < while
    b 1 i>u32 i32and 0 i>u32 i32<> if
      res a i32+ -> res
    then
    a 1 i32<< -> a
    b 1 u32>> -> b
    i 1 + -> i
  repeat
  res
end

default fn u32/ ( a :i32 b :i32 -> :i32 )
  var q :i32
  var r :i32
  var i :i
  0 i>i32 -> q
  0 i>i32 -> r
  31 -> i
  begin i 0 >= while
    r 1 i32<< -> r
    a i u32>> 1 i>u32 i32and r i32or -> r
    r b u32>= if
      r b i32- -> r
      q 1 i>u32 i i32<< i32or -> q
    then
    i 1 - -> i
  repeat
  q
end

default fn u32mod ( a :i32 b :i32 -> :i32 )
  var r :i32
  var i :i
  0 i>i32 -> r
  31 -> i
  begin i 0 >= while
    r 1 i32<< -> r
    a i u32>> 1 i>u32 i32and r i32or -> r
    r b u32>= if
      r b i32- -> r
    then
    i 1 - -> i
  repeat
  r
end
