\ 24-bit fixed-point Mandelbrot for Agon Light (eZ80 ADL mode)
\ Showcases:
\   1. Native 24-bit :i fixed-point arithmetic (9-bit fraction, scale = 512)
\   2. Flat 24-bit addressing > 64 KiB (76,800-byte 320x240 off-screen buffer in bss)
\   3. Agon VDP Mode 8 graphics via RST.LIL $10

require "io.ir4"

var fb :bytes 76800

fn emit16 ( v :i )
  v 255 and emit
  v 8 >> 255 and emit
end

fn vdu_mode ( m :i )
  22 emit
  m emit
end

fn vdu_gcol ( c :i )
  18 emit
  0 emit
  c emit
end

fn vdu_plot ( mode :i x :i y :i )
  25 emit
  mode emit
  x emit16
  y emit16
end

\ Compute Mandelbrot iteration count (0..31) in 9-bit fixed-point (1.0 = 512)
fn mandel_px ( cr :i ci :i -> :i )
  var zr :i
  var zi :i
  var zr2 :i
  var zi2 :i
  var it :i
  0 -> zr
  0 -> zi
  0 -> it
  begin it 32 < while
    zr zr * 9 >> -> zr2
    zi zi * 9 >> -> zi2
    zr2 zi2 + 2048 > if
      it return
    then
    zr zi * 8 >> ci + -> zi
    zr2 zi2 - cr + -> zr
    it 1 + -> it
  repeat
  0
end

fn render_fb ( )
  var px :i
  var py :i
  var cr :i
  var ci :i
  var p :a
  fb -> p
  0 -> py
  begin py 240 < while
    \ ci = -1.125 + py * (2.25 / 240) ~= -576 + (py * 48) / 10
    py 48 * 10 / 576 - -> ci
    0 -> px
    begin px 320 < while
      \ cr = -2.1 + px * (3.0 / 320) ~= -1075 + (px * 48) / 10
      px 48 * 10 / 1075 - -> cr
      cr ci mandel_px p i8!
      p 1 a+ -> p
      px 1 + -> px
    repeat
    py 1 + -> py
  repeat
end

fn blit_fb ( )
  var py :i
  var px :i
  var x0 :i
  var c :i
  var y :i
  var p :a
  fb -> p
  0 -> py
  begin py 240 < while
    239 py - 4 * -> y
    0 -> px
    begin px 320 < while
      p u8@ -> c
      px -> x0
      begin
        px 320 < if p u8@ c = else 0 then
      while
        p 1 a+ -> p
        px 1 + -> px
      repeat
      c 0 <> if
        c 63 and vdu_gcol
        4 x0 4 * y vdu_plot
        5 px 1 - 4 * y vdu_plot
      then
    repeat
    py 1 + -> py
  repeat
end

fn main ( -> :i )
  8 vdu_mode
  render_fb
  blit_fb
  0
end
