\ Amiga Boing Ball demo using portable gfx.ir4 + sprite.ir4 (Agon Light & Commander X16)
\ Procedurally generates 8 rotation frames of a 48x48 tilted checkered sphere
\ using lib/math.ir4 (sqrt, atan2), uploads them via sprdef, and bounces at 60 fps.

require "sprite.ir4"
require "math.ir4"

var ilat_buf :bytes 2304
var ilon_buf :bytes 2304
var spr_buf  :bytes 2304

fn draw_grid ( )
  \ Grey background, purple grid
  170 170 170 gfxrgb gfxcolor
  0 0 320 240 gfxfillrect
  170 0 255 gfxrgb gfxcolor
  40 -> var x :i
  begin x 280 <= while
    x 16 x 216 gfxline
    x 216 160 x 160 - 13 * 10 / + 228 gfxline
    x 20 + -> x
  repeat
  16 -> var y :i
  begin y 216 <= while
    40 y 280 y gfxline
    y 20 + -> y
  repeat
  30 219 290 219 gfxline
  18 223 302 223 gfxline
  4 228 316 228 gfxline
end

fn precompute_sphere ( )
  0 -> var idx :i
  0 -> var py :i
  begin py 48 < while
    py 24 - i>f -> var fy :f
    0 -> var px :i
    begin px 48 < while
      px 24 - i>f -> var fx :f
      fx fx f* fy fy f* f+ -> var r2 :f
      r2 576.0 f< 0 = if
        -1 ilat_buf idx a+ i8!
        0 ilon_buf idx a+ i8!
      else
        576.0 r2 f- sqrt -> var fz :f
        fx 0.96 f* fy 0.28 f* f- -> var tx :f
        fx 0.28 f* fy 0.96 f* f+ -> var ty :f
        ty 576.0 ty ty f* f- 0.001 f+ sqrt atan2 -> var lat :f
        tx fz atan2 -> var lon :f
        lat 1.570796 f+ 1.909859 f* f>i ilat_buf idx a+ i8!
        lon 1.570796 f+ 15.27887 f* f>i ilon_buf idx a+ i8!
      then
      idx 1 + -> idx
      px 1 + -> px
    repeat
    py 1 + -> py
  repeat
end

var ball_pal :bytes 2
var shadow_pal :bytes 1

fn upload_ball_frame ( frame :i )
  0 -> var idx :i
  begin idx 2304 < while
    ilat_buf idx a+ i8@ -> var ilat :i
    ilat 0 < if
      0 spr_buf idx a+ i8!
    else
      ilon_buf idx a+ u8@ frame 1 << + 3 >> -> var ilon :i
      ilat ilon + 1 and 0 = if 2 else 1 then spr_buf idx a+ i8!
    then
    idx 1 + -> idx
  repeat
  frame 1 + 48 48 spr_buf ball_pal 2 sprdef drop
end

fn upload_shadow ( )
  0 -> var idx :i
  0 -> var py :i
  begin py 48 < while
    py 24 - -> var y :i
    0 -> var px :i
    begin px 48 < while
      px 24 - -> var x :i
      x x * y y * + 576 >= px py + 1 and 0 <> or if
        0 spr_buf idx a+ i8!
      else
        1 spr_buf idx a+ i8!
      then
      idx 1 + -> idx
      px 1 + -> px
    repeat
    py 1 + -> py
  repeat
  0 48 48 spr_buf shadow_pal 1 sprdef drop
end

fn setup_sprites ( )
  255 255 255 gfxrgb ball_pal i8!
  255 0 0 gfxrgb ball_pal 1 a+ i8!
  0 0 0 gfxrgb shadow_pal i8!
  precompute_sphere
  upload_shadow
  0 -> var f :i
  begin f 8 < while
    f upload_ball_frame
    f 1 + -> f
  repeat
end

fn main ( -> :i )
  320 240 6 gfxinit
  draw_grid
  setup_sprites
  40 -> var x :i
  400 -> var y8 :i
  1 -> var vx :i
  0 -> var vy :i
  0 -> var tick :i
  0 -> var f :i
  1 -> var cur_spr :i
  0 x 8 + y8 4 >> 2 - sprpos
  cur_spr x y8 4 >> sprpos
  0 1 sprshow
  cur_spr 1 sprshow
  begin inkey 0 = while
    x vx + -> x
    x 30 < if 30 -> x 1 -> vx then
    x 232 > if 232 -> x -1 -> vx then
    vy 1 + -> vy
    y8 vy + -> y8
    y8 2880 >= if
      2880 -> y8
      -54 -> vy
    then
    tick 3 and 0 = if
      vx 0 > if f 1 + 7 and -> f else f 1 - 7 and -> f then
      vx 0 > if f 1 - 7 and -> f else f 1 + 7 and -> f then
    then
    f 1 + -> var next_spr :i
    0 x 8 + y8 4 >> 2 - sprpos
    next_spr x y8 4 >> sprpos
    next_spr cur_spr <> if
      next_spr 1 sprshow
      cur_spr 0 sprshow
      next_spr -> cur_spr
    then
    gfxvsync
    tick 1 + -> tick
  repeat
  gfxdone
  0
end
