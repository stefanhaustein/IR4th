\ Amiga Boing Ball demo for Agon Light (eZ80 ADL mode + VDP hardware sprites)
\ Procedurally generates 8 rotation frames of a 48x48 tilted checkered sphere
\ using lib/math.ir4 (sqrt, arctan) + AgDev float32, uploads them as VDP
\ sprite frames, draws the perspective grid, and bounces at 60 fps.

require "gfx.ir4"
require "math.ir4"

var ilat_buf :bytes 2304
var ilon_buf :bytes 2304

fn emit16 ( v :i )
  v 255 and emit
  v 8 >> 255 and emit
end

fn vdu_23_27 ( cmd :i )
  23 emit 27 emit cmd emit
end

fn draw_grid ( )
  var x :i
  var y :i
  \ Grey background, purple grid
  170 170 170 gfxrgb gfxcolor
  0 0 320 240 gfxfillrect
  170 0 255 gfxrgb gfxcolor
  40 -> x
  begin x 280 <= while
    x 16 x 216 gfxline
    x 216 160 x 160 - 13 * 10 / + 228 gfxline
    x 20 + -> x
  repeat
  16 -> y
  begin y 216 <= while
    40 y 280 y gfxline
    y 20 + -> y
  repeat
  30 219 290 219 gfxline
  18 223 302 223 gfxline
  4 228 316 228 gfxline
end

fn precompute_sphere ( )
  var py :i
  var px :i
  var fx :f
  var fy :f
  var r2 :f
  var fz :f
  var tx :f
  var ty :f
  var lat :f
  var lon :f
  var idx :i
  0 -> idx
  0 -> py
  begin py 48 < while
    py 24 - i>f -> fy
    0 -> px
    begin px 48 < while
      px 24 - i>f -> fx
      fx fx f* fy fy f* f+ -> r2
      r2 576.0 f< 0 = if
        -1 ilat_buf idx a+ i8!
        0 ilon_buf idx a+ i8!
      else
        576.0 r2 f- sqrt -> fz
        fx 0.96 f* fy 0.28 f* f- -> tx
        fx 0.28 f* fy 0.96 f* f+ -> ty
        ty 576.0 ty ty f* f- 0.001 f+ sqrt atan2 -> lat
        tx fz atan2 -> lon
        \ 6 latitude bands across [-pi/2..+pi/2], 6 longitude bands in 0..48 (8 per square)
        lat 1.570796 f+ 1.909859 f* f>i ilat_buf idx a+ i8!
        lon 1.570796 f+ 15.27887 f* f>i ilon_buf idx a+ i8!
      then
      idx 1 + -> idx
      px 1 + -> px
    repeat
    py 1 + -> py
  repeat
end

fn upload_ball_frame ( frame :i )
  var py :i
  var px :i
  var idx :i
  var ilat :i
  var ilon :i
  23 emit 27 emit 0 emit frame emit
  23 emit 27 emit 1 emit 48 emit16 48 emit16
  0 -> idx
  0 -> py
  begin py 48 < while
    0 -> px
    begin px 48 < while
      ilat_buf idx a+ i8@ -> ilat
      ilat 0 < if
        0 emit 0 emit 0 emit 0 emit
      else
        ilon_buf idx a+ u8@ frame 1 << + 3 >> -> ilon
        ilat ilon + 1 and 0 = if
          255 emit 0 emit 0 emit 255 emit
        else
          255 emit 255 emit 255 emit 255 emit
        then
      then
      idx 1 + -> idx
      px 1 + -> px
    repeat
    py 1 + -> py
  repeat
end

fn upload_shadow_frame ( frame :i )
  var py :i
  var px :i
  var x :i
  var y :i
  23 emit 27 emit 0 emit frame emit
  23 emit 27 emit 1 emit 48 emit16 48 emit16
  0 -> py
  begin py 48 < while
    py 24 - -> y
    0 -> px
    begin px 48 < while
      px 24 - -> x
      x x * y y * + 576 >= px py + 1 and 0 <> or if
        0 emit 0 emit 0 emit 0 emit
      else
        0 emit 0 emit 0 emit 255 emit
      then
      px 1 + -> px
    repeat
    py 1 + -> py
  repeat
end

fn setup_sprites ( )
  var f :i
  precompute_sphere
  0 -> f
  begin f 8 < while
    f upload_ball_frame
    f 1 + -> f
  repeat
  8 upload_shadow_frame
  \ Sprite 0 = shadow (drawn behind ball)
  23 emit 27 emit 4 emit 0 emit
  5 vdu_23_27
  23 emit 27 emit 6 emit 8 emit
  11 vdu_23_27
  \ Sprite 1 = ball (drawn in front)
  23 emit 27 emit 4 emit 1 emit
  5 vdu_23_27
  0 -> f
  begin f 8 < while
    23 emit 27 emit 6 emit f emit
    f 1 + -> f
  repeat
  11 vdu_23_27
  23 emit 27 emit 7 emit 2 emit
end

fn main ( -> :i )
  var x :i
  var y8 :i
  var vx :i
  var vy :i
  var tick :i
  8 gfxmode
  16 vdu_23_27
  draw_grid
  setup_sprites
  40 -> x
  400 -> y8
  1 -> vx
  0 -> vy
  0 -> tick
  begin inkey 0 = while
    x vx + -> x
    x 30 < if 30 -> x 1 -> vx then
    x 232 > if 232 -> x -1 -> vx then
    vy 1 + -> vy
    y8 vy + -> y8
    y8 2880 >= if
      2880 -> y8
      -54 -> vy
    then
    \ Move shadow (sprite 0) offset to the right & slightly up
    23 emit 27 emit 4 emit 0 emit
    23 emit 27 emit 13 emit x 8 + emit16 y8 4 >> 2 - emit16
    \ Move & animate ball (sprite 1)
    23 emit 27 emit 4 emit 1 emit
    23 emit 27 emit 13 emit x emit16 y8 4 >> emit16
    tick 3 and 0 = if
      vx 0 > if 9 vdu_23_27 else 8 vdu_23_27 then
    then
    gfxvsync
    15 vdu_23_27
    tick 1 + -> tick
  repeat
  16 vdu_23_27
  gfxdone
  0
end
