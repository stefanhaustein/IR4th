\ Juggling Beachballs demo using portable gfx.ir4 + sprite.ir4 (C64, X16, Agon)
\ Generates 8 rotation frames of a 21x21 2-color beachball (fitting C64's 24x21
\ sprite size with no scaling) and animates 8 bouncing balls independently via sprimg + sprset.

require "sprite.ir4"

var lon_buf  :bytes 441
var spr_buf  :bytes 441
var ball_pal :bytes 2

var bx  :bytes 16
var by8 :bytes 16
var bvx :bytes 16
var bvy :bytes 16
var rng_state :i

fn rng_next ( -> :i )
  rng_state 25173 * 13849 + -> rng_state
  rng_state 1 u>>
end

data atan_lut
  0 :i8 1 :i8 2 :i8 3 :i8 4 :i8 5 :i8 5 :i8 6 :i8 7 :i8
  8 :i8 9 :i8 9 :i8 10 :i8 10 :i8 11 :i8 12 :i8 12 :i8
end

fn draw_grid_bg ( )
  170 170 170 gfxrgb gfxcolor
  gfxclear
end

fn draw_h_step ( idx :i )
  170 0 255 gfxrgb gfxcolor
  gfxheight 24 - -> var ybot :i
  ybot 16 - 10 / -> var dy :i
  idx 11 < if
    16 idx dy * + -> var y :i
    40 y 280 y gfxline
    return
  then
  idx 11 = if
    30 ybot 3 + 290 ybot 3 + gfxline
    18 ybot 7 + 302 ybot 7 + gfxline
    4 ybot 12 + 316 ybot 12 + gfxline
  then
end

fn draw_grid_step ( step :i )
  170 0 255 gfxrgb gfxcolor
  gfxheight 24 - -> var ybot :i
  40 step 40 * + -> var x :i
  x 280 <= if
    x 16 x ybot gfxline
    x ybot 160 x 160 - 13 * 10 / + ybot 12 + gfxline
    x 20 + -> x
    x 280 <= if
      x 16 x ybot gfxline
      x ybot 160 x 160 - 13 * 10 / + ybot 12 + gfxline
    then
  then
end

hot fn isqrt ( n :i -> :i )
  n 0 <= if 0 return then
  0 -> var res :i
  16384 -> var bit :i
  begin bit n > while bit 2 u>> -> bit repeat
  begin bit 0 <> while
    n res bit + >= if
      n res bit + - -> n
      res 1 u>> bit + -> res
    else
      res 1 u>> -> res
    then
    bit 2 u>> -> bit
  repeat
  res
end

hot fn iatan_half ( y :i x :i -> :i )
  y 0 < if 0 y - else y then -> var ay :i
  0 -> var a :i
  x 0 = ay 0 = and if 0 return then
  ay x <= if
    atan_lut ay 4 << x / a+ u8@ -> a
  else
    24 atan_lut x 4 << ay / a+ u8@ - -> a
  then
  y 0 < if 0 a - return then
  a
end

hot fn precompute_ball ( )
  0 -> var py :i
  begin py 21 < while
    py 10 - -> var dy :i
    102 dy dy * - -> var r2row :i
    py 21 * -> var row_off :i
    r2row 0 <= if
      0 -> var px :i
      begin px 21 < while
        -1 lon_buf row_off px + a+ i8!
        px 1 + -> px
      repeat
    else
      0 -> px
      r2row 4 << isqrt -> var x_edge :i
      begin px 21 < while
        px 10 - -> var dx :i
        r2row dx dx * - -> var z2 :i
        z2 0 <= if
          -1 lon_buf row_off px + a+ i8!
        else
          dx 2 << 24 * x_edge / 24 + -> var lon :i
          lon 0 < if 0 -> lon then
          lon 47 > if 47 -> lon then
          lon lon_buf row_off px + a+ i8!
        then
        px 1 + -> px
      repeat
    then
    py 1 and 0 = if py 1 >> draw_h_step then
    py 1 + -> py
  repeat
  11 draw_h_step
end

hot fn upload_ball_frame ( frame :i )
  0 -> var idx :i
  begin idx 441 < while
    lon_buf idx a+ i8@ -> var lon :i
    lon 0 < if
      0 spr_buf idx a+ i8!
    else
      lon frame 3 * 1 >> + 48 mod 12 / 1 and 1 + spr_buf idx a+ i8!
    then
    idx 1 + -> idx
  repeat
  frame 21 21 spr_buf ball_pal 2 sprimg drop
end

fn setup_sprites ( )
  255 255 255 gfxrgb ball_pal i8!
  255 0 0 gfxrgb ball_pal 1 a+ i8!
  precompute_ball
  0 -> var f :i
  begin f 16 < while
    f upload_ball_frame
    f 1 and 0 = if f 1 >> draw_grid_step then
    f 1 + -> f
  repeat
end

fn step_balls ( tick :i floor8 :i )
  tick 2 >> 15 and -> var phase :i
  tick 3 and 0 = -> var rot :i
  0 -> var i :i
  begin i 8 < while
    i 1 << -> var off :i
    bx off a+ i16@ bvx off a+ i16@ + -> var x8 :i
    x8 384 < if 384 -> x8 0 bvx off a+ i16@ - bvx off a+ i16! then
    x8 4352 > if 4352 -> x8 0 bvx off a+ i16@ - bvx off a+ i16! then
    x8 bx off a+ i16!

    bvy off a+ i16@ 1 + -> var vy :i
    by8 off a+ i16@ vy + -> var y8 :i
    y8 floor8 >= if
      floor8 -> y8
      -90 -> vy
    then
    vy bvy off a+ i16!
    y8 by8 off a+ i16!

    i x8 4 >> y8 5 >> sprpos
    rot 0 <> if
      bvx off a+ i16@ 0 > if 15 phase - else phase then i 1 << + 15 and -> var frm :i
      i frm sprset
    then
    i 1 + -> i
  repeat
end

fn main ( -> :i )
  320 240 6 gfxinit
  draw_grid_bg
  setup_sprites

  12345 -> rng_state
  gfxheight 45 - 5 << -> var floor8 :i
  0 -> var i :i
  begin i 8 < while
    480 rng_next 3520 mod + bx i 1 << a+ i16!
    320 rng_next 2400 mod + by8 i 1 << a+ i16!
    rng_next 9 mod 6 + rng_next 1 and 0 = if 0 swap - then bvx i 1 << a+ i16!
    rng_next 41 mod 24 - bvy i 1 << a+ i16!
    i i 1 << 15 and sprset
    i 1 sprshow
    i 1 + -> i
  repeat

  0 -> var tick :i
  begin inkey 0 = while
    tick floor8 step_balls
    gfxvsync
    tick 1 + -> tick
  repeat
  gfxdone
  0
end
