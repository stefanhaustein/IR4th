\ Cross-platform 6-bit fixed-point Mandelbrot set using gfx.ir4
\ 1.0 = 64 (fits safely in 16-bit :i on 6502/Z80 as well as 24/32/64-bit targets)

require "stdio.ir4"
require "gfx.ir4"

var pal :bytes 64

fn init_pal ( )
  var i :i
  var d :i
  gfxdepth -> d
  0 pal i8!
  1 -> i
  begin i 32 < while
    d 1 = if
      i 1 and
    else
      i 3 << 255 and
      i 5 << 255 and
      i 7 << 255 and
      gfxrgb
    then
    pal i a+ i8!
    i 1 + -> i
  repeat
end

hot fn mandel_px ( cr :i ci :i -> :i )
  var zr :i
  var zi :i
  var zr2 :i
  var zi2 :i
  var it :i
  0 -> zr
  0 -> zi
  0 -> it
  begin it 32 < while
    zr zr * 6 >> -> zr2
    zi zi * 6 >> -> zi2
    zr2 zi2 + 256 > if
      it return
    then
    zr zi * 5 >> ci + -> zi
    zr2 zi2 - cr + -> zr
    it 1 + -> it
  repeat
  0
end

fn render_mandel ( )
  var w :i
  var h :i
  var px :i
  var py :i
  var cr :i
  var ci :i
  var x0 :i
  var c :i
  var nc :i
  gfxwidth -> w
  gfxheight -> h
  0 gfxcolor
  gfxclear
  0 -> py
  begin py h < while
    py 36 * h 2 u>> / 72 - -> ci
    0 -> px
    0 -> x0
    -1 -> c
    begin px w < while
      px 48 * w 2 u>> / 134 - -> cr
      pal cr ci mandel_px a+ u8@ -> nc
      nc c <> if
        c 0 > if
          c gfxcolor
          x0 py px x0 - gfxhline
        then
        px -> x0
        nc -> c
      then
      px 1 + -> px
    repeat
    c 0 > if
      c gfxcolor
      x0 py w x0 - gfxhline
    then
    py 1 + -> py
  repeat
end

fn main ( -> :i )
  160 120 8 gfxinit
  init_pal
  render_mandel
  key drop
  gfxdone
  0
end
